{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/video/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/index.html",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/articles/index.html",
      "destination": "/articles",
      "permanent": true
    },
    {
      "source": "/products/jet-lighter-alternative-moto.html",
      "destination": "/products/jet-lighter.html",
      "permanent": true
    },
    {
      "source": "/articles/moto-vs-lion-jet-lighter.html",
      "destination": "/articles/which-jet-lighter-brand.html",
      "permanent": true
    },
    {
      "source": "/products/:slug([a-z0-9-]+)",
      "destination": "/products/:slug.html",
      "permanent": true
    },
    {
      "source": "/articles/:slug([a-z0-9-]+)",
      "destination": "/articles/:slug.html",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html",
      "permanent": true
    },
    {
      "source": "/en/index.html",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/en/products/index.html",
      "destination": "/en/products",
      "permanent": true
    },
    {
      "source": "/en/articles/index.html",
      "destination": "/en/articles",
      "permanent": true
    },
    {
      "source": "/en/products/tools-:rest",
      "destination": "/products/tools-:rest",
      "permanent": false
    },
    {
      "source": "/en/products/mtt-brand.html",
      "destination": "/products/mtt-brand.html",
      "permanent": false
    },
    {
      "source": "/en/products/:slug([a-z0-9-]+)",
      "destination": "/en/products/:slug.html",
      "permanent": true
    },
    {
      "source": "/en/articles/:slug([a-z0-9-]+)",
      "destination": "/en/articles/:slug.html",
      "permanent": true
    },
    {
      "source": "/en/privacy",
      "destination": "/en/privacy.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/en/assets/:path*",
      "destination": "/assets/:path*"
    }
  ]
}
